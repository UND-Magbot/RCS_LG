# RCS_LG 백엔드 설정 — 이 파일을 `config.env` 로 복사해서 값을 채우세요.
#
# 서버 PC 에서는 실행 스크립트를 고치지 않고 이 파일만 수정하면 됩니다.
# 이미 설정된 환경변수(run_local.ps1 등)가 있으면 그쪽이 우선합니다.
#
#   copy config.env.example config.env

# ── DB 접속 ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=rcs_lg_db

# ── 관제 화면 정적 파일 위치 (선택) ────────────────────────
# 비워두면 BackEnd/web 을 씁니다.
# frontend 를 `BUILD_STATIC=1 npm run build` 로 빌드한 뒤 나오는 `out/` 폴더를
# BackEnd/web 으로 복사하면 백엔드가 8002 에서 관제 화면까지 같이 서빙합니다.
# WEB_DIR=C:\RCS_LG\BackEnd\web
