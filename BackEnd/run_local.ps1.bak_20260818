# RCS_LG 백엔드 실행 (서버 PC 운영용)
#
# 경로 독립: $PSScriptRoot 기준으로만 동작하므로 폴더를 어디로 옮겨도 그대로 쓸 수 있다.
#   현재 위치: C:\Users\Administrator\Desktop\RCS_LGIT\BackEnd

# ── DB 접속 ──────────────────────────────────────────────
$env:DB_NAME     = "rcs_lg_db"
$env:DB_HOST     = "127.0.0.1"    # DB 가 같은 PC 에 있음
$env:DB_USER     = "root"
$env:DB_PASSWORD = "1234"         # 로컬 MariaDB root 비번

# ── venv 확인 ────────────────────────────────────────────
$venvPython = Join-Path $PSScriptRoot "venv\Scripts\python.exe"
if (-not (Test-Path $venvPython)) {
    Write-Host "[오류] venv 가 없습니다: $venvPython" -ForegroundColor Red
    Write-Host ""
    Write-Host "다음을 먼저 실행하세요:" -ForegroundColor Yellow
    Write-Host "  cd `"$PSScriptRoot`""
    Write-Host "  py -3.11 -m venv venv"
    Write-Host "  .\venv\Scripts\python.exe -m pip install --upgrade pip"
    Write-Host "  .\venv\Scripts\pip.exe install fastapi `"uvicorn[standard]`" sqlalchemy pymysql apscheduler passlib `"bcrypt==4.0.1`" python-jose requests websocket-client"
    Write-Host ""
    Write-Host "  ※ requirements.txt 는 쓰지 마세요 (UTF-16 인코딩 + 불필요 패키지 3GB)" -ForegroundColor DarkYellow
    exit 1
}

# uvicorn 이 app.main 을 찾으려면 작업 디렉터리가 BackEnd 여야 한다.
# (작업 스케줄러로 실행될 때 cwd 가 C:\Windows\System32 인 문제 방지)
Set-Location $PSScriptRoot

# 운영에서는 --reload 를 쓰지 않는다.
#   - 파일 감시로 CPU 를 계속 먹는다
#   - 파일이 저장 중인 순간 재시작이 걸리면 서버가 죽는다
& $venvPython -m uvicorn app.main:app --host 0.0.0.0 --port 8002
